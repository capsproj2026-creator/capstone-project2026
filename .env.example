APP_NAME="Smart Campus VMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Local only: set APP_DEBUG=true. Never enable debug in production (leaks stack traces / env).
APP_URL=http://localhost

# Google Sign-In (optional). Create OAuth client at https://console.cloud.google.com/
# Authorized redirect URI: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_ALLOWED_DOMAIN=my.cspc.edu.ph

# Visitor pre-registration via Google Form (optional).
# When GOOGLE_FORM_URL is set, QR codes point to the form and /visitor/pre-register redirects there.
# Apps Script POSTs to {APP_URL}/api/visitor/pre-register/google with VISITOR_PRE_REGISTER_WEBHOOK_TOKEN.
VISITOR_PRE_REGISTER_GOOGLE_FORM_URL=
VISITOR_PRE_REGISTER_WEBHOOK_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS lets artisan serve handle AI + browser requests at once (required on Windows).
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb
# Mode: atlas (MongoDB Atlas cloud) | local (127.0.0.1)
MONGODB_MODE=atlas
MONGODB_DATABASE=capstone
# Fill these, then run: powershell -ExecutionPolicy Bypass -File .\scripts\setup-atlas-mongo.ps1
MONGODB_ATLAS_USER=
MONGODB_ATLAS_PASSWORD=
MONGODB_ATLAS_HOST=
MONGODB_ATLAS_APP_NAME=CapstoneDatabase
# Or paste full URI (overrides MONGODB_ATLAS_* above)
MONGODB_URI=
# Required for Atlas users created in the admin auth database.
MONGODB_AUTH_DATABASE=admin
# Recommended true on Windows/XAMPP for Atlas TLS.
MONGODB_TLS_ALLOW_INVALID=true
# Cloud connection resilience (works for Atlas and local MongoDB).
MONGODB_CONNECT_TIMEOUT_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_SOCKET_TIMEOUT_MS=30000
MONGODB_MAX_POOL_SIZE=10
MONGODB_RETRY_READS=true
# Local-only fallback (single machine, not shared across devices):
# MONGODB_URI=mongodb://127.0.0.1:27017

CACHE_STORE=file
QUEUE_CONNECTION=sync

MYSQL_IMPORT_HOST=127.0.0.1
MYSQL_IMPORT_PORT=3306
MYSQL_IMPORT_DATABASE=capstone
MYSQL_IMPORT_USERNAME=root
MYSQL_IMPORT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave SESSION_DOMAIN unset for localhost (do not set to the string "null")

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
# Brevo (formerly Sendinblue) free SMTP relay — replace placeholders with your Brevo credentials.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login@example.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-verified-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Laravel Reverb (run: php artisan reverb:start)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Shared secret for ESP32 RFID gate API (header: X-RFID-TOKEN only)
RFID_API_TOKEN=
# Physical boom servo is wired to this gate ESP32 (Entry). Exit grants open via heartbeat.
RFID_SHARED_BOOM_GATE_ID=GATE-IN-1
# Set true for hardware demo so Exit RFID opens the Entry servo without a prior Entry tap.
RFID_ALLOW_EXIT_WITHOUT_ENTRY=false
# Unknown RFID tap at Entry: one-time temporary pass. Identity key = hashed RFID UID.
RFID_TEMP_ACCESS_ENABLED=true
RFID_TEMP_ACCESS_HOURS=5
RFID_TEMP_ACCESS_MAX=3

# Declined registration remedial gate (document correction window)
REGISTRATION_REMEDIAL_GATE_ENABLED=true
REGISTRATION_REMEDIAL_HOURS=5
REGISTRATION_REMEDIAL_ONE_ENTRY=true

# YOLOv9 AI parking service (header: X-AI-TOKEN only)
# Pretrained Ultralytics weights: yolov9t | yolov9s | yolov9m | yolov9c (default) | yolov9e
# Run: .\scripts\setup-yolov9.ps1  to download weights into hardware/ai_parking/models/
AI_PARKING_YOLO_MODEL=yolov9c
# Use the same token in Laravel and the Python service (scripts/start-ai-parking.ps1 loads .env).
# Leave empty to refuse occupancy posts (503). Set a long random value before deploy.
AI_PARKING_API_TOKEN=
AI_PARKING_STREAM_BASE=http://127.0.0.1:8090
AI_PARKING_STREAM_URL=http://127.0.0.1:8090/stream.mjpg
AI_PARKING_STREAM_BROWSER_URL=http://127.0.0.1:8090/stream.mjpg
# Map each camera to a real ParkingArea id. Rollout: ACAD 1 (4) -> Duran (3) -> Auditorium (8). See hardware/ai_parking/CALIBRATION_ROLLOUT.md
AI_PARKING_AREA_ID=4
AI_STREAM_PORT=8090
AI_PARKING_INGEST_STALE_SECONDS=45
# AI_LARAVEL_API_BASE=http://127.0.0.1:8000
AI_PARKING_OVERTIME_MINUTES=30
AI_PARKING_VIOLATION_DEBOUNCE_MINUTES=10
# Set to 1 to OCR plates and match them to registered users (requires EasyOCR)
AI_PARKING_OCR_ENABLED=1
AI_PARKING_OCR_EVERY_SEC=2
AI_PARKING_OCR_MIN_CONF=0.26
AI_PARKING_OCR_UPSCALE_FACTOR=8
AI_PARKING_OCR_UPSCALE_MIN_WIDTH=720
AI_PARKING_OCR_UNREADABLE_BELOW=0.18
AI_PARKING_OCR_QUEUE_SIZE=8
AI_PARKING_OCR_GPU=0
AI_PARKING_OCR_HIGH_CONF_LOCK=0.65
AI_PARKING_OCR_ROTATION_ANGLES=-6,-3,3,6
AI_PARKING_PLATE_VOTE_NEEDED=2
AI_PARKING_PLATE_VOTE_CONSENSUS_RATIO=0.55
# Dedicated plate YOLO (run: .\scripts\setup-plate-model.ps1) — tighter OCR crops
AI_PARKING_PLATE_MODEL_VARIANT=v1s
AI_PARKING_PLATE_MODEL=models/plate.pt
AI_PARKING_PLATE_YOLO_CONF=0.22
AI_PARKING_TRACK_HOLD_SEC=3.0
# Long-range / distant plates (~20 m lot): full-res infer + tiny boxes + OCR upscale
AI_PARKING_LONG_RANGE=1
AI_PARKING_LONG_RANGE_MIN_BOX_AREA=0.00012
AI_PARKING_CONF=0.20
AI_PARKING_IOU=0.50
AI_PARKING_INFER_EVERY_SEC=0.40
AI_PARKING_POST_EVERY_SEC=2.5
AI_PARKING_INFER_MAX_WIDTH=2560
AI_PARKING_MAX_DET=50
AI_PARKING_IMG_SIZE=1280
AI_PARKING_MIN_BOX_AREA=0.00012
AI_PARKING_BOX_HOLD_SEC=0.45
AI_PARKING_LOOKUP_TIMEOUT_SEC=2.5
# AI overlay stream max width (browser). Live Cameras uses PREVIEW_MAX_WIDTH separately.
AI_PARKING_AI_STREAM_MAX_WIDTH=2560
AI_PARKING_AI_STREAM_JPEG_QUALITY=90
AI_PARKING_MONITOR_SHARPEN=1
AI_PARKING_DETECT_PERSONS=0
AI_PARKING_OCR_PARKED_ONLY=1

# Campus ID auto-scan on registration (EasyOCR + OpenCV)
# Leave blank to auto-use .venv-campus-id-ocr in the project root (run scripts/setup-campus-id-ocr.ps1 once).
CAMPUS_ID_OCR_PYTHON=
AI_PARKING_MOTION_SPEED_THRESH=0.12
AI_PARKING_MOTION_PARK_SEC=1.5
AI_PARKING_MOTION_SMOOTH_ALPHA=0.35
# 1 = vehicles only (car, motorcycle, bus, truck). No persons or other objects.
AI_PARKING_VEHICLES_ONLY=1
# Vehicle types to detect (1=on). Default: cars + motorcycles + buses + trucks.
AI_PARKING_DETECT_CARS=1
AI_PARKING_DETECT_MOTORCYCLES=1
AI_PARKING_DETECT_BUSES=1
AI_PARKING_DETECT_TRUCKS=1
# Smaller min box for motorcycles (they appear smaller than cars at same distance).
AI_PARKING_MOTORCYCLE_MIN_BOX_AREA=0.00006
AI_PARKING_MIN_VEHICLE_ASPECT=0.28
AI_PARKING_MAX_VEHICLE_ASPECT=4.5
AI_PARKING_MIN_VEHICLE_SHORT_SIDE_PX=18
# 0 = per-camera IoU tracker (recommended for multi-cam). 1 = Ultralytics ByteTrack.
AI_PARKING_USE_TRACKER=0

# ---------- CAM-AI-1: wired Dahua (YOLOv9 + live) ----------
AI_CAMERA_1_ID=CAM-AI-1
AI_CAMERA_1_NAME="Duran Hall Front"
AI_CAMERA_1_LOCATION="Duran Hall Front"
AI_CAMERA_1_IP=192.168.1.108
AI_CAMERA_1_USER=admin
AI_CAMERA_1_PASS=
AI_CAMERA_1_PORT=554
AI_CAMERA_1_RTSP_PATH=/cam/realmonitor?channel=1&subtype=0
AI_CAMERA_1_AREA_ID=4
AI_CAMERA_1_ZONES=zones_acad1.json
AI_CAMERA_1_STREAM_PATH=/stream.mjpg
AI_CAMERA_1_STREAM_URL=http://127.0.0.1:8090/stream.mjpg
AI_CAMERA_1_AI_STREAM_PATH=/CAM-AI-1/ai/stream.mjpg
AI_CAMERA_1_AI_STREAM_URL=http://127.0.0.1:8090/CAM-AI-1/ai/stream.mjpg
AI_CAMERA_1_ENABLED=true
# Long-range: main stream subtype=0 at full 2560x1440 for YOLO + OCR crops
AI_CAMERA_1_PREVIEW_RTSP_PATH=/cam/realmonitor?channel=1&subtype=0
AI_CAMERA_1_RTSP_TRANSPORT=udp
AI_CAMERA_1_PREVIEW_MAX_WIDTH=2560
AI_CAMERA_1_INFER_MAX_WIDTH=2560
AI_CAMERA_1_AI_STREAM_MAX_WIDTH=2560
AI_CAMERA_1_STREAM_FPS=12
AI_CAMERA_1_JPEG_QUALITY=88
AI_CAMERA_1_FLUSH_FRAMES=2
AI_CAMERA_1_LITE_PREVIEW=false
# Legacy aliases for camera 1
AI_CAMERA_IP=192.168.1.108
AI_CAMERA_USER=admin
AI_CAMERA_PASS=
AI_CAMERA_PORT=554
AI_CAMERA_RTSP_PATH=/cam/realmonitor?channel=1&subtype=0

# ---------- CAM-AI-2: Tapo C310 wireless ----------
# Keep TCP + stream1 defaults (do not force wired low-latency knobs here)
# REQUIRED: Tapo app → Settings → Advanced → Camera Account (not TP-Link cloud login)
AI_CAMERA_2_ID=CAM-AI-2
AI_CAMERA_2_NAME="Talipapa"
AI_CAMERA_2_LOCATION="Talipapa"
AI_CAMERA_2_IP=192.168.1.104
AI_CAMERA_2_USER=
AI_CAMERA_2_PASS=
AI_CAMERA_2_PORT=554
AI_CAMERA_2_RTSP_PATH=/stream1
AI_CAMERA_2_AREA_ID=3
AI_CAMERA_2_ZONES=zones_duran.json
AI_CAMERA_2_STREAM_PATH=/CAM-AI-2/stream.mjpg
AI_CAMERA_2_STREAM_URL=http://127.0.0.1:8090/CAM-AI-2/stream.mjpg
AI_CAMERA_2_AI_STREAM_PATH=/CAM-AI-2/ai/stream.mjpg
AI_CAMERA_2_AI_STREAM_URL=http://127.0.0.1:8090/CAM-AI-2/ai/stream.mjpg
AI_CAMERA_2_ENABLED=true
AI_CAMERA_2_RTSP_TRANSPORT=tcp
# Tapo C310 native max (~2304×1296) — keep high so plates stay readable
AI_CAMERA_2_PREVIEW_MAX_WIDTH=2304
AI_CAMERA_2_INFER_MAX_WIDTH=2304
AI_CAMERA_2_STREAM_FPS=15
AI_CAMERA_2_JPEG_QUALITY=75
AI_CAMERA_2_LITE_PREVIEW=false

# ---------- CAM-AI-3: shows Offline until IP/USER/PASS set; ENABLED=true + STREAM_URL lists the tile ----------
AI_CAMERA_3_ID=CAM-AI-3
AI_CAMERA_3_NAME="Campus Camera 3"
AI_CAMERA_3_LOCATION="Visitor Parking"
AI_CAMERA_3_IP=
AI_CAMERA_3_USER=
AI_CAMERA_3_PASS=
AI_CAMERA_3_PORT=554
AI_CAMERA_3_RTSP_PATH=/stream1
AI_CAMERA_3_AREA_ID=9
AI_CAMERA_3_STREAM_PATH=/CAM-AI-3/stream.mjpg
AI_CAMERA_3_STREAM_URL=http://127.0.0.1:8090/CAM-AI-3/stream.mjpg
AI_CAMERA_3_AI_STREAM_PATH=/CAM-AI-3/ai/stream.mjpg
AI_CAMERA_3_AI_STREAM_URL=http://127.0.0.1:8090/CAM-AI-3/ai/stream.mjpg
AI_CAMERA_3_ENABLED=true
AI_CAMERA_3_PREVIEW_MAX_WIDTH=2304
AI_CAMERA_3_INFER_MAX_WIDTH=2304
AI_CAMERA_3_JPEG_QUALITY=75

# ---------- CAM-AI-4: optional fourth feed ----------
AI_CAMERA_4_ID=CAM-AI-4
AI_CAMERA_4_NAME="Campus Camera 4"
AI_CAMERA_4_LOCATION="Campus Camera 4"
AI_CAMERA_4_IP=
AI_CAMERA_4_USER=
AI_CAMERA_4_PASS=
AI_CAMERA_4_PORT=554
AI_CAMERA_4_RTSP_PATH=/stream1
AI_CAMERA_4_AREA_ID=10
AI_CAMERA_4_STREAM_PATH=/CAM-AI-4/stream.mjpg
AI_CAMERA_4_STREAM_URL=http://127.0.0.1:8090/CAM-AI-4/stream.mjpg
AI_CAMERA_4_AI_STREAM_PATH=/CAM-AI-4/ai/stream.mjpg
AI_CAMERA_4_AI_STREAM_URL=http://127.0.0.1:8090/CAM-AI-4/ai/stream.mjpg
AI_CAMERA_4_ENABLED=false

# GitHub sync (scripts/sync-project.ps1 + scripts/auto-sync-github.ps1)
GITHUB_REPO_URL=https://github.com/capsproj2026-creator/capstone-project2026.git
GITHUB_BRANCH=main
# When true, start-system.ps1 opens a background pull+push watcher (or run .\start-git-sync.ps1)
GITHUB_AUTO_SYNC=false

APP_TIMEZONE=Asia/Manila
