APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Local only: set APP_DEBUG=true. Never enable debug in production (leaks stack traces / env).
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb
# Use MongoDB Atlas for a cloud database shared across devices (recommended).
# Get the URI from Atlas → Connect → Drivers, then paste it here.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority&appName=CapstoneDatabase
MONGODB_DATABASE=capstone
# Required for Atlas users created in the admin auth database.
MONGODB_AUTH_DATABASE=admin
# Set to true only for local dev if Atlas TLS fails on Windows (e.g. XAMPP OpenSSL).
MONGODB_TLS_ALLOW_INVALID=false
# Cloud connection resilience (works for Atlas and local MongoDB).
MONGODB_CONNECT_TIMEOUT_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_SOCKET_TIMEOUT_MS=30000
MONGODB_MAX_POOL_SIZE=10
MONGODB_RETRY_READS=true
# Local-only fallback (single machine, not shared across devices):
# MONGODB_URI=mongodb://127.0.0.1:27017

CACHE_STORE=file
QUEUE_CONNECTION=sync

MYSQL_IMPORT_HOST=127.0.0.1
MYSQL_IMPORT_PORT=3306
MYSQL_IMPORT_DATABASE=capstone
MYSQL_IMPORT_USERNAME=root
MYSQL_IMPORT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave SESSION_DOMAIN unset for localhost (do not set to the string "null")

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
# Brevo (formerly Sendinblue) free SMTP relay — replace placeholders with your Brevo credentials.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login@example.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-verified-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Laravel Reverb (run: php artisan reverb:start)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Shared secret for ESP32 RFID gate API (header: X-RFID-TOKEN only)
RFID_API_TOKEN=

# YOLOv9 AI parking service (header: X-AI-TOKEN only)
# Use the same token in Laravel and the Python service (scripts/start-ai-parking.ps1 loads .env)
AI_PARKING_API_TOKEN=capstone-ai-parking-dev-token-change-me
AI_PARKING_STREAM_BASE=http://127.0.0.1:8090
AI_PARKING_STREAM_URL=http://127.0.0.1:8090/stream.mjpg
AI_PARKING_STREAM_BROWSER_URL=http://127.0.0.1:8090/stream.mjpg
AI_PARKING_AREA_ID=19
AI_STREAM_PORT=8090
AI_PARKING_INGEST_STALE_SECONDS=45
# AI_LARAVEL_API_BASE=http://127.0.0.1:8000
AI_PARKING_OVERTIME_MINUTES=30
AI_PARKING_VIOLATION_DEBOUNCE_MINUTES=10
# Set to 1 to OCR plates and match them to registered users (requires EasyOCR)
AI_PARKING_OCR_ENABLED=1
AI_PARKING_OCR_EVERY_SEC=3
AI_PARKING_OCR_MIN_CONF=0.35
AI_PARKING_OCR_UNREADABLE_BELOW=0.22
AI_PARKING_PLATE_VOTE_NEEDED=1
AI_PARKING_TRACK_HOLD_SEC=3.0
AI_PARKING_CONF=0.28
AI_PARKING_IOU=0.50
AI_PARKING_INFER_EVERY_SEC=0.30
AI_PARKING_POST_EVERY_SEC=1.5
AI_PARKING_INFER_MAX_WIDTH=960
AI_PARKING_IMG_SIZE=640
AI_PARKING_MIN_BOX_AREA=0.0005
AI_PARKING_BOX_HOLD_SEC=0.45
AI_PARKING_LOOKUP_TIMEOUT_SEC=2.5
AI_PARKING_DETECT_PERSONS=0
# 0 = per-camera IoU tracker (recommended for multi-cam). 1 = Ultralytics ByteTrack.
AI_PARKING_USE_TRACKER=0

# ---------- CAM-AI-1: wired Dahua (YOLOv9 + live) ----------
AI_CAMERA_1_ID=CAM-AI-1
AI_CAMERA_1_NAME="AI Test Lot"
AI_CAMERA_1_LOCATION="Parking Lot A"
AI_CAMERA_1_IP=192.168.1.108
AI_CAMERA_1_USER=admin
AI_CAMERA_1_PASS=
AI_CAMERA_1_PORT=554
AI_CAMERA_1_RTSP_PATH=/cam/realmonitor?channel=1&subtype=0
AI_CAMERA_1_AREA_ID=19
AI_CAMERA_1_STREAM_PATH=/stream.mjpg
AI_CAMERA_1_STREAM_URL=http://127.0.0.1:8090/stream.mjpg
AI_CAMERA_1_ENABLED=true
# Low-latency live preview (substream); YOLO stays on main RTSP_PATH above
AI_CAMERA_1_PREVIEW_RTSP_PATH=/cam/realmonitor?channel=1&subtype=1
AI_CAMERA_1_RTSP_TRANSPORT=udp
# ~960px live preview; YOLO infer uses AI_PARKING_INFER_MAX_WIDTH separately
AI_CAMERA_1_PREVIEW_MAX_WIDTH=960
AI_CAMERA_1_STREAM_FPS=20
AI_CAMERA_1_JPEG_QUALITY=60
AI_CAMERA_1_FLUSH_FRAMES=4
AI_CAMERA_1_LITE_PREVIEW=true
# Legacy aliases for camera 1
AI_CAMERA_IP=192.168.1.108
AI_CAMERA_USER=admin
AI_CAMERA_PASS=
AI_CAMERA_PORT=554
AI_CAMERA_RTSP_PATH=/cam/realmonitor?channel=1&subtype=0

# ---------- CAM-AI-2: Tapo C310 wireless ----------
# Keep TCP + stream1 defaults (do not force wired low-latency knobs here)
# REQUIRED: Tapo app → Settings → Advanced → Camera Account (not TP-Link cloud login)
AI_CAMERA_2_ID=CAM-AI-2
AI_CAMERA_2_NAME="AI Lot B"
AI_CAMERA_2_LOCATION="Parking Lot B"
AI_CAMERA_2_IP=192.168.1.104
AI_CAMERA_2_USER=
AI_CAMERA_2_PASS=
AI_CAMERA_2_PORT=554
AI_CAMERA_2_RTSP_PATH=/stream1
AI_CAMERA_2_AREA_ID=20
AI_CAMERA_2_STREAM_PATH=/CAM-AI-2/stream.mjpg
AI_CAMERA_2_STREAM_URL=http://127.0.0.1:8090/CAM-AI-2/stream.mjpg
AI_CAMERA_2_ENABLED=true
AI_CAMERA_2_RTSP_TRANSPORT=tcp
# Tapo C310 native max (~2304×1296) — keep high so plates stay readable
AI_CAMERA_2_PREVIEW_MAX_WIDTH=2304
AI_CAMERA_2_INFER_MAX_WIDTH=2304
AI_CAMERA_2_STREAM_FPS=15
AI_CAMERA_2_JPEG_QUALITY=75
AI_CAMERA_2_LITE_PREVIEW=false

# ---------- CAM-AI-3: Tapo template (set ENABLED=true + IP/USER/PASS when ready) ----------
AI_CAMERA_3_ID=CAM-AI-3
AI_CAMERA_3_NAME="AI Lot C"
AI_CAMERA_3_LOCATION="Visitor Parking"
AI_CAMERA_3_IP=
AI_CAMERA_3_USER=
AI_CAMERA_3_PASS=
AI_CAMERA_3_PORT=554
AI_CAMERA_3_RTSP_PATH=/stream1
AI_CAMERA_3_AREA_ID=21
AI_CAMERA_3_STREAM_PATH=/CAM-AI-3/stream.mjpg
AI_CAMERA_3_STREAM_URL=http://127.0.0.1:8090/CAM-AI-3/stream.mjpg
AI_CAMERA_3_ENABLED=false
AI_CAMERA_3_PREVIEW_MAX_WIDTH=2304
AI_CAMERA_3_INFER_MAX_WIDTH=2304
AI_CAMERA_3_JPEG_QUALITY=75

APP_TIMEZONE=Asia/Manila
