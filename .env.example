APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb
# Use MongoDB Atlas for a cloud database shared across devices (recommended).
# Get the URI from Atlas → Connect → Drivers, then paste it here.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority&appName=CapstoneDatabase
MONGODB_DATABASE=capstone
# Required for Atlas users created in the admin auth database.
MONGODB_AUTH_DATABASE=admin
# Set to true only for local dev if Atlas TLS fails on Windows (e.g. XAMPP OpenSSL).
MONGODB_TLS_ALLOW_INVALID=false
# Cloud connection resilience (works for Atlas and local MongoDB).
MONGODB_CONNECT_TIMEOUT_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_SOCKET_TIMEOUT_MS=30000
MONGODB_MAX_POOL_SIZE=10
MONGODB_RETRY_READS=true
# Local-only fallback (single machine, not shared across devices):
# MONGODB_URI=mongodb://127.0.0.1:27017

CACHE_STORE=file
QUEUE_CONNECTION=sync

MYSQL_IMPORT_HOST=127.0.0.1
MYSQL_IMPORT_PORT=3306
MYSQL_IMPORT_DATABASE=capstone
MYSQL_IMPORT_USERNAME=root
MYSQL_IMPORT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave SESSION_DOMAIN unset for localhost (do not set to the string "null")

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
# Brevo (formerly Sendinblue) free SMTP relay — replace placeholders with your Brevo credentials.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login@example.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-verified-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shared secret for ESP32 RFID gate API (header: X-RFID-TOKEN only)
RFID_API_TOKEN=

# YOLOv9 AI parking service (header: X-AI-TOKEN only)
AI_PARKING_API_TOKEN=
AI_PARKING_STREAM_URL=http://127.0.0.1:8090/stream.mjpg
AI_PARKING_AREA_ID=19
AI_CAMERA_IP=192.168.1.108
# Python service → Laravel (set to your PC LAN IP if ESP/other hosts call in)
# AI_LARAVEL_API_BASE=http://127.0.0.1:8000
AI_PARKING_OVERTIME_MINUTES=30
AI_PARKING_VIOLATION_DEBOUNCE_MINUTES=10
# Python-side (optional): AI_PARKING_OCR_ENABLED=1  AI_PARKING_OCR_EVERY_SEC=8

APP_TIMEZONE=Asia/Manila
